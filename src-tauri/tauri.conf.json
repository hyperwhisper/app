{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omegawhisper",
  "mainBinaryName": "omegawhisper",
  "version": "0.1.0",
  "identifier": "dev.omegawhisper",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Omegawhisper",
        "width": 700,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["ydotool"]
      },
      "rpm": {
        "depends": ["ydotool"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    }
  }
}
